APP_ENV=local
DATABASE_URL=sqlite:///./consumer_kg.db
NEO4J_ENABLED=false
# Auto bridge for a Windows-loopback Neo4j Desktop when running in WSL
NEO4J_WSL_BRIDGE=auto
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
LLM_ENABLED=false
LLM_BASE_URL=https://your-openai-compatible-service/v1
LLM_API_KEY=
ADMIN_API_KEY=
LLM_TIMEOUT_SECONDS=50
LLM_MAX_RETRIES=3
# replace-me
LLM_MODEL=your-model
API_KEY=
# Insight Agent: bounded read-only tool execution and per-call model timeout
AGENT_THINKING=auto
AGENT_PARALLEL_TOOLS=true
AGENT_MAX_TOOL_CALLS=6
AGENT_LLM_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
CORS_ORIGINS=[]

# Docker Compose database secrets (set before starting containers)
POSTGRES_PASSWORD=change-this
